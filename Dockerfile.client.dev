FROM node:22-bookworm-slim
RUN corepack enable && mkdir /workspace && chown node:node /workspace
USER node
WORKDIR /workspace
COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=node:node packages/client/package.json packages/client/package.json
RUN CI=true pnpm --filter client install --frozen-lockfile --ignore-scripts
WORKDIR /workspace/packages/client
EXPOSE 33000
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
